---
import { getDict, type Locale } from '@/i18n';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = getDict(locale).strategicLocation;
---

<section id="strategic-location" class="bg-white pt-8 pb-12 rounded-t-3xl">
  <div class="container-content flex flex-col gap-10">
    <div class="reveal flex flex-col gap-3 items-start max-w-3xl mx-auto">
      <div class="inline-flex items-center bg-bg-dark text-white px-3 py-1.5 rounded-3xl text-[11px] font-bold uppercase tracking-[2px]">
        {t.eyebrow}
      </div>
      <h2 class="serif text-[#222] text-2xl sm:text-3xl md:text-4xl leading-[1.1] tracking-[-0.01em]">
        {t.title}
      </h2>
      <p class="text-[14px] sm:text-[15px] leading-[24px] text-[#525252]">
        {t.intro}
        <br /><br />
        {t.introTrail}
      </p>
    </div>

    <!-- Map area -->
    <div class="reveal relative w-full max-w-3xl mx-auto aspect-[1104/621] rounded-3xl overflow-hidden bg-[#d5dee3]">
      <img
        src="/images/location/map.jpg"
        alt=""
        aria-hidden="true"
        class="absolute inset-0 w-full h-full object-cover"
      />

      <!-- Pin: Tbilisi Boulevard (right-side label) -->
      <div class="absolute flex items-center gap-2" style="left: 10%; top: 30%;">
        <span class="serif text-sm sm:text-base md:text-lg text-[#222] whitespace-nowrap tracking-[-0.02em]">
          {t.pins.boulevard}
        </span>
        <svg width="24" height="32" viewBox="0 0 24 32" class="shrink-0">
          <path d="M12 0C5.4 0 0 5.2 0 11.6c0 6 12 20.4 12 20.4s12-14.4 12-20.4C24 5.2 18.6 0 12 0z" fill="#B89651"/>
          <circle cx="12" cy="11.6" r="4.5" fill="white"/>
        </svg>
      </div>

      <!-- Pin: Gino Paradise -->
      <div class="absolute flex items-center gap-2" style="left: 38%; top: 32%;">
        <svg width="24" height="32" viewBox="0 0 24 32" class="shrink-0">
          <path d="M12 0C5.4 0 0 5.2 0 11.6c0 6 12 20.4 12 20.4s12-14.4 12-20.4C24 5.2 18.6 0 12 0z" fill="#B89651"/>
          <circle cx="12" cy="11.6" r="4.5" fill="white"/>
        </svg>
        <span class="serif text-sm sm:text-base md:text-lg text-[#222] whitespace-nowrap tracking-[-0.02em]">
          {t.pins.gino}
        </span>
      </div>

      <!-- Pin: Tbilisi new zoo -->
      <div class="absolute flex items-center gap-2" style="left: 64%; top: 50%;">
        <svg width="24" height="32" viewBox="0 0 24 32" class="shrink-0">
          <path d="M12 0C5.4 0 0 5.2 0 11.6c0 6 12 20.4 12 20.4s12-14.4 12-20.4C24 5.2 18.6 0 12 0z" fill="#B89651"/>
          <circle cx="12" cy="11.6" r="4.5" fill="white"/>
        </svg>
        <span class="serif text-sm sm:text-base md:text-lg text-[#222] whitespace-nowrap tracking-[-0.02em]">
          {t.pins.zoo}
        </span>
      </div>

      <!-- Pin: Jazz Hotel (dark navy) -->
      <div class="absolute flex items-end gap-2" style="left: 34%; top: 89%; transform: translateY(-100%);">
        <svg width="28" height="38" viewBox="0 0 24 32" class="shrink-0">
          <path d="M12 0C5.4 0 0 5.2 0 11.6c0 6 12 20.4 12 20.4s12-14.4 12-20.4C24 5.2 18.6 0 12 0z" fill="#162536"/>
          <circle cx="12" cy="11.6" r="4.5" fill="#B89651"/>
        </svg>
        <span class="serif text-sm sm:text-base md:text-lg text-[#222] whitespace-nowrap tracking-[-0.02em] font-medium">
          {t.pins.hotel}
        </span>
      </div>

      <!-- Photo: boulevard area (left) -->
      <div class="absolute hidden md:block rounded-3xl overflow-hidden" style="left: 8%; top: 39%; width: 23%; aspect-ratio: 256/171;">
        <img src="/images/location/boulevard.jpg" alt="Tbilisi Boulevard" class="w-full h-full object-cover" />
      </div>

      <!-- Photo: gino paradise (top center) -->
      <div class="absolute hidden md:block rounded-3xl overflow-hidden" style="left: 42%; top: 4%; width: 23%; aspect-ratio: 256/171;">
        <img src="/images/location/gino.jpg" alt="Gino Paradise" class="w-full h-full object-cover" />
      </div>

      <!-- Photo: zoo (right) -->
      <div class="absolute hidden md:block rounded-3xl overflow-hidden" style="left: 68%; top: 59%; width: 23%; aspect-ratio: 256/171;">
        <img src="/images/location/zoo.jpg" alt="Tbilisi new zoo" class="w-full h-full object-cover" />
      </div>
    </div>

    <!-- Bullets + closing -->
    <div class="reveal flex flex-col gap-4 max-w-3xl mx-auto text-[#525252] text-[14px] sm:text-[15px] leading-[24px]">
      <ul class="list-disc pl-7 flex flex-col gap-2">
        {t.bullets.map((b) => (
          <li>{b}</li>
        ))}
      </ul>
      <p>{t.closing}</p>
    </div>
  </div>
</section>
