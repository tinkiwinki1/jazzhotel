---
import Eyebrow from '@/components/ui/Eyebrow.astro';
import Section from '@/components/ui/Section.astro';
import NdaRequestForm from '@/components/form/NdaRequestForm';
import { getDict, type Locale } from '@/i18n';
import { contact } from '@/config';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = getDict(locale).cta;
const f = getDict(locale).form;
---

<Section id="nda" variant="dark">
  <div class="grid lg:grid-cols-[1fr_1.1fr] gap-12 lg:gap-20 items-start">
    <div class="reveal">
      <Eyebrow text={t.eyebrow} variant="dark" />
      <h2 class="display-hero text-ink-white mt-5 leading-tight">
        <span class="block">{t.titleLine1}</span>
        <span class="block text-gold">{t.titleLine2}</span>
      </h2>
      <div class="h-px w-24 bg-gold mt-8 mb-8"></div>
      <p class="text-base md:text-lg text-ink-mutedDk leading-relaxed max-w-md">
        {t.body}
      </p>
    </div>

    <div class="reveal">
      <NdaRequestForm
        client:load
        labels={f}
        locale={locale}
        whatsappUrl={contact.whatsapp}
        telegramUrl={contact.telegram}
      />
    </div>
  </div>
</Section>
