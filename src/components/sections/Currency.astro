---
import FxChartStatic from '@/components/sections/FxChartStatic.astro';
import { getDict, type Locale } from '@/i18n';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = getDict(locale).currency;

const maxAbs = Math.max(...t.peers.map((p) => Math.abs(p.pct)));
---

<section id="currency" class="bg-[#ededed] pt-12 pb-10 rounded-t-3xl">
  <div class="container-content">
    <div class="max-w-3xl mx-auto flex flex-col gap-10">
      <div class="reveal flex flex-col gap-3 items-start">
        <div class="inline-flex items-center bg-bg-dark text-white px-3 py-1.5 rounded-3xl text-[11px] font-bold uppercase tracking-[2px]">
          {t.eyebrow}
        </div>
        <h2 class="serif text-[#1F2937] text-2xl sm:text-3xl md:text-4xl leading-[1.1] tracking-[-0.01em]">
          {t.title}
        </h2>
      </div>

      <div class="grid lg:grid-cols-2 gap-6 items-stretch">
        <div class="reveal bg-white rounded-3xl p-5 md:p-6 flex flex-col gap-3 h-full">
          <div class="text-[11px] font-bold uppercase tracking-[2px] text-[#222]">{t.chartLabel}</div>
          <div class="flex-1 flex items-center justify-center">
            <FxChartStatic annotations={t.annotations} />
          </div>
          <div class="text-[11px] italic text-[#525252]">{t.sourceChart}</div>
        </div>

        <div class="reveal flex flex-col gap-6">
          <div class="bg-[#e6a25b] rounded-3xl p-5 md:p-6 flex flex-col gap-2">
            <div class="text-[11px] font-bold uppercase tracking-[2px] text-white">{t.currentRateLabel}</div>
            <div class="serif text-white text-2xl md:text-3xl leading-tight">{t.currentRate}</div>
            <div class="text-[13px] md:text-sm font-medium text-white">{t.currentRateNote}</div>
          </div>

          <div class="flex flex-col gap-2">
            <div class="text-[11px] font-bold uppercase tracking-[2px] text-[#222]">{t.comparisonLabel}</div>

            <div class="grid grid-cols-2 text-[10px] tracking-[1.5px] uppercase text-[#525252]">
              <div class="text-left">← {t.axisLabels.weaker}</div>
              <div class="text-right">{t.axisLabels.stronger} →</div>
            </div>

            <div class="flex flex-col gap-3 pt-1">
              {t.peers.map((p) => {
                const isPositive = p.pct >= 0;
                const widthPct = (Math.abs(p.pct) / maxAbs) * 50;
                const color =
                  p.pct >= 0
                    ? 'bg-[#B89651]'
                    : p.pct >= -10
                    ? 'bg-[#8A7340]/80'
                    : p.pct >= -25
                    ? 'bg-[#3A4A60]'
                    : 'bg-[#B5443A]';
                return (
                  <div class="grid grid-cols-[60px_1fr_56px] gap-3 items-center">
                    <div>
                      <div class="serif text-base text-[#222] leading-tight">{p.code}</div>
                      <div class="text-[11px] text-[#525252]">{p.label}</div>
                    </div>

                    <div class="relative h-7 bg-white">
                      <div class="absolute left-1/2 -translate-x-1/2 top-[-2px] bottom-[-2px] w-px bg-[#1F2937]/60"></div>

                      {!isPositive && (
                        <div
                          class={`absolute top-0 bottom-0 right-1/2 ${color} growth-bar-fill origin-right`}
                          style={`--bar-pct: ${widthPct}%`}
                        ></div>
                      )}
                      {isPositive && (
                        <div
                          class={`absolute top-0 bottom-0 left-1/2 ${color} growth-bar-fill origin-left`}
                          style={`--bar-pct: ${widthPct}%`}
                        ></div>
                      )}
                    </div>

                    <div class={`serif text-base tabular text-right ${isPositive ? 'text-[#8A7340]' : 'text-[#222]'}`}>
                      {isPositive ? '+' : ''}{p.pct}%
                    </div>
                  </div>
                );
              })}
            </div>
            <div class="text-[11px] italic text-[#525252] pt-1">{t.sourceComparison}</div>
          </div>
        </div>
      </div>

      <div class="reveal bg-bg-dark rounded-3xl p-5 md:p-7">
        <p class="serif italic text-sm md:text-base leading-[1.6] text-[#F5F1E8]">
          {t.takeaway}
        </p>
      </div>
    </div>
  </div>
</section>
