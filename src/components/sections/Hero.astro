---
import { getDict, type Locale } from '@/i18n';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = getDict(locale).hero;
---

<section
  id="top"
  class="relative w-full overflow-hidden bg-bg-dark text-ink-white min-h-screen flex items-center bg-center bg-no-repeat"
  style="background-image: linear-gradient(rgba(27,28,47,0.3), rgba(27,28,47,0.3)), url('/images/hero.png'); background-size: 100% 100%, 100% 100%;"
>

  <div class="relative z-10 w-full px-6 md:px-12 pt-28 pb-16 md:pt-32 md:pb-24">
    <div class="max-w-content mx-auto flex flex-col items-center gap-5 md:gap-6 reveal">
      <h1 class="serif text-white text-center leading-none tracking-[-0.02em] text-5xl sm:text-6xl md:text-8xl lg:text-[140px]">
        {t.titleLarge}
      </h1>

      <p class="text-center text-white text-xs md:text-sm font-bold uppercase tracking-[0.18em] max-w-xl">
        {t.eyebrow}
      </p>

      <div class="flex flex-col md:flex-row gap-3 md:gap-5 mt-1 md:mt-2 items-stretch">
        <!-- Cap rate card (light) -->
        <div class="flex items-stretch h-[76px] rounded-3xl bg-[#d5dee3] backdrop-blur-sm overflow-hidden">
          <div class="flex items-center justify-center min-w-[72px] px-4">
            <span class="serif text-4xl md:text-5xl text-bg-dark leading-none tabular" data-count-up>{t.capRate}</span>
          </div>
          <div class="flex flex-col justify-center pl-2 pr-5 py-3 max-w-[230px]">
            <div class="text-[10px] md:text-[11px] font-bold uppercase tracking-[0.2em] text-[#525252] leading-[1.4]">
              {t.capRateLabel}
            </div>
            <div class="text-[10px] md:text-[11px] text-[#525252] mt-1 leading-[1.4]">
              {t.capRateNote}
            </div>
          </div>
        </div>

        <!-- Booking rating card (dark) -->
        <div class="flex items-stretch h-[76px] rounded-3xl bg-bg-dark backdrop-blur-sm overflow-hidden">
          <div class="flex items-center justify-center min-w-[72px] px-4">
            <span class="serif text-4xl md:text-5xl text-white leading-none tabular" data-count-up>{t.booking.score}</span>
          </div>
          <div class="flex flex-col justify-center pl-2 pr-5 py-3 max-w-[230px]">
            <div class="serif text-sm md:text-base text-white leading-tight">
              {t.booking.label}
            </div>
            <div class="text-[10px] md:text-[11px] text-white/85 mt-0.5 flex items-center gap-1.5 tabular">
              <span>{t.booking.reviews}</span>
              <span class="text-white/40">·</span>
              <span class="text-white/85">{t.booking.source}</span>
            </div>
          </div>
        </div>
      </div>

      <a
        href="#nda"
        class="mt-3 md:mt-4 bg-white text-ink rounded-full px-6 py-3 text-xs md:text-sm font-bold tracking-[0.1em] uppercase hover:bg-gold-soft transition-colors"
      >
        {t.cta}
      </a>
    </div>
  </div>
</section>
