---
import { getDict, type Locale } from '@/i18n';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = getDict(locale).asset;
---

<section id="asset" class="bg-[#ededed] pt-8 pb-12">
  <div class="container-content">
    <div class="max-w-3xl mx-auto flex flex-col gap-10">
      <div class="reveal flex flex-col gap-3 items-start">
        <div class="inline-flex items-center bg-bg-dark text-white px-3 py-1.5 rounded-3xl text-[11px] font-bold uppercase tracking-[2px]">
          {t.eyebrow}
        </div>
        <h2 class="serif text-[#222] text-2xl sm:text-3xl md:text-4xl leading-[1.1] tracking-[-0.01em]">
          {t.title}
        </h2>
      </div>

      <div class="grid md:grid-cols-2 gap-6 lg:gap-8 items-stretch">
        <div class="reveal bg-white rounded-3xl px-5 py-4 md:px-6 md:py-5">
          <dl class="flex flex-col">
            {t.rows.map((r, i) => (
              <div class={`grid grid-cols-[1fr_2fr] gap-5 py-3 ${i < t.rows.length - 1 ? 'border-b border-[rgba(82,82,82,0.4)]' : ''}`}>
                <dt class="text-[11px] md:text-[12px] font-normal uppercase tracking-[0.6px] text-[#525252] leading-5">
                  {r.label}
                </dt>
                <dd class="text-[13px] md:text-[14px] text-[#222] leading-5">
                  {r.value}
                </dd>
              </div>
            ))}
          </dl>
        </div>

        <div class="reveal rounded-3xl overflow-hidden h-[380px] md:h-auto">
          <img
            src="/images/asset.jpg"
            alt={t.galleryAlt2 || t.title}
            loading="lazy"
            class="w-full h-full object-cover"
          />
        </div>
      </div>
    </div>
  </div>
</section>
