---
import Eyebrow from '@/components/ui/Eyebrow.astro';
import Section from '@/components/ui/Section.astro';
import { getDict, type Locale } from '@/i18n';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = getDict(locale).asset;
---

<Section id="asset" variant="light">
  <div class="reveal">
    <Eyebrow text={t.eyebrow} />
    <h2 class="h1-section mt-4 max-w-2xl">{t.title}</h2>
  </div>

  <div class="grid lg:grid-cols-[1fr_1.15fr] gap-12 lg:gap-16 mt-12 md:mt-16">
    <!-- Definition table -->
    <div class="reveal">
      <dl class="border-t border-line-dim/60">
        {t.rows.map((r) => (
          <div class="grid grid-cols-[1fr_2fr] gap-6 py-3.5 border-b border-line-dim/40">
            <dt class="text-xs md:text-sm tracking-[0.05em] uppercase text-ink-mutedLt font-medium">
              {r.label}
            </dt>
            <dd class="text-sm md:text-[15px] text-ink">{r.value}</dd>
          </div>
        ))}
      </dl>
    </div>

    <!-- Photo mosaic -->
    <div class="reveal grid grid-cols-6 gap-3 md:gap-4 auto-rows-[100px] md:auto-rows-[140px]">
      <button
        type="button"
        data-gallery-trigger
        data-gallery-index="0"
        class="group relative col-span-6 row-span-3 overflow-hidden bg-card-dark"
        aria-label={t.photos[0].alt}
      >
        <img
          src={t.photos[0].src}
          alt={t.photos[0].alt}
          loading="lazy"
          class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
        />
        <span class="absolute bottom-3 right-3 text-[10px] tracking-[0.2em] uppercase text-ink-white/90 bg-bg-dark/60 px-3 py-1.5">
          ↗ View
        </span>
      </button>

      <button type="button" data-gallery-trigger data-gallery-index="1"
        class="group relative col-span-3 row-span-2 overflow-hidden bg-card-dark"
        aria-label={t.photos[1].alt}>
        <img src={t.photos[1].src} alt={t.photos[1].alt} loading="lazy"
          class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" />
      </button>

      <button type="button" data-gallery-trigger data-gallery-index="2"
        class="group relative col-span-3 row-span-2 overflow-hidden bg-card-dark"
        aria-label={t.photos[2].alt}>
        <img src={t.photos[2].src} alt={t.photos[2].alt} loading="lazy"
          class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" />
      </button>

      <button type="button" data-gallery-trigger data-gallery-index="3"
        class="group relative col-span-3 row-span-2 overflow-hidden bg-card-dark"
        aria-label={t.photos[3].alt}>
        <img src={t.photos[3].src} alt={t.photos[3].alt} loading="lazy"
          class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" />
      </button>

      <button type="button" data-gallery-trigger data-gallery-index="4"
        class="group relative col-span-3 row-span-2 overflow-hidden bg-card-dark"
        aria-label={t.photos[4].alt}>
        <img src={t.photos[4].src} alt={t.photos[4].alt} loading="lazy"
          class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" />
      </button>
    </div>
  </div>
</Section>

<script type="application/json" id="asset-gallery-data" set:html={JSON.stringify(t.photos)} is:inline />
