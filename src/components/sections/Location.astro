---
import { getDict, type Locale } from '@/i18n';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = getDict(locale).location;
const c = t.georgiaCard;
---

<section id="location" class="bg-bg-dark text-white py-12 md:py-16 rounded-3xl">
  <div class="container-content">
    <div class="max-w-3xl mx-auto flex flex-col gap-10">
      <div class="reveal flex flex-col gap-3 items-start">
        <div class="inline-flex items-center bg-white text-[#222] px-3 py-1.5 rounded-3xl text-[11px] font-bold uppercase tracking-[2px]">
          {t.eyebrow}
        </div>
        <h2 class="serif text-white text-2xl sm:text-3xl md:text-4xl leading-[1.1] tracking-[-0.01em]">
          {t.title}
        </h2>
      </div>

      <div class="grid lg:grid-cols-[1fr_360px] gap-6 lg:gap-8 items-start">
        <div class="reveal flex flex-col gap-5">
          <div class="text-[11px] font-bold uppercase tracking-[2px] text-white">
            {t.sectionLabel}
          </div>
          <ul class="flex flex-col gap-5">
            {t.bullets.map((b) => (
              <li class="flex gap-4 items-start pl-2">
                <span class="text-gold text-xl leading-none mt-1 shrink-0">◆</span>
                <div class="flex flex-col gap-1">
                  <div class="serif text-white text-[15px] sm:text-base leading-[1.35]">{b.title}</div>
                  <p class="text-[13px] sm:text-sm text-white/70 leading-[1.5]">{b.body}</p>
                </div>
              </li>
            ))}
          </ul>
        </div>

        <div class="reveal bg-[#d5dee3] border border-gold-soft rounded-3xl p-6 md:p-7 flex flex-col gap-5">
          <div class="text-[11px] font-bold uppercase tracking-[2px] text-[#525252]">
            {c.title}
          </div>

          <div class="bg-white rounded-2xl px-5 py-3 flex flex-col gap-3">
            <div class="text-[11px] font-bold uppercase tracking-[1.6px] text-[#222]">{c.arrivalsLabel}</div>
            <div class="grid grid-cols-4 gap-2">
              {c.arrivals.map((row) => (
                <div class="flex flex-col gap-1">
                  <div class="text-[10px] uppercase tracking-[1.5px] text-[#525252] leading-4">{row.year}</div>
                  <div class="serif text-[#222] text-base leading-tight">{row.value}</div>
                </div>
              ))}
            </div>
            <div class="self-end inline-flex items-baseline gap-2 px-4 py-1 bg-[#e6a25b] rounded-2xl">
              <span class="serif text-white text-2xl leading-none">{c.arrivalsDelta}</span>
              <span class="text-[11px] font-bold uppercase tracking-[2px] text-white">{c.arrivalsDeltaLabel}</span>
            </div>
          </div>

          <div class="bg-white rounded-2xl px-5 py-3 flex flex-col gap-3">
            <div class="text-[11px] font-bold uppercase tracking-[1.6px] text-[#222]">{c.gdpLabel}</div>
            <div class="grid grid-cols-4 gap-2">
              {c.gdp.map((row) => (
                <div class="flex flex-col gap-1">
                  <div class="text-[10px] uppercase tracking-[1.5px] text-[#525252] leading-4">{row.year}</div>
                  <div class="serif text-[#222] text-base leading-tight">{row.value}</div>
                </div>
              ))}
            </div>
            <div class="self-end inline-flex items-baseline gap-2 px-4 py-1 bg-[#e6a25b] rounded-2xl">
              <span class="serif text-white text-2xl leading-none">{c.gdpDelta}</span>
              <span class="text-[11px] font-bold uppercase tracking-[2px] text-white">{c.gdpDeltaLabel}</span>
            </div>
          </div>

          <div class="text-right text-[11px] italic text-[#525252]">{c.source}</div>
        </div>
      </div>
    </div>
  </div>
</section>
