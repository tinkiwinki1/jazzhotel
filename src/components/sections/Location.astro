---
import Eyebrow from '@/components/ui/Eyebrow.astro';
import Section from '@/components/ui/Section.astro';
import { getDict, type Locale } from '@/i18n';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = getDict(locale).location;
const c = t.georgiaCard;
---

<Section id="location" variant="light">
  <div class="reveal">
    <Eyebrow text={t.eyebrow} />
    <h2 class="h1-section mt-4 max-w-3xl">{t.title}</h2>
  </div>

  <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 mt-12 md:mt-16">
    <!-- Bullets -->
    <div class="reveal">
      <div class="eyebrow text-gold-deep mb-6 md:mb-8">{t.sectionLabel}</div>
      <ul class="flex flex-col gap-7 md:gap-9">
        {t.bullets.map((b) => (
          <li class="grid grid-cols-[auto_1fr] gap-5 items-start">
            <span class="text-gold text-xl md:text-2xl leading-none mt-0.5">◆</span>
            <div>
              <div class="serif text-lg md:text-xl text-ink">{b.title}</div>
              <p class="text-sm md:text-[15px] text-ink-mutedLt mt-1.5 leading-relaxed">
                {b.body}
              </p>
            </div>
          </li>
        ))}
      </ul>
    </div>

    <!-- Georgia card -->
    <div class="reveal bg-tan-card/50 border border-line-dim p-6 md:p-9">
      <div class="eyebrow text-gold-deep mb-6">{c.title}</div>

      <div class="space-y-8">
        <!-- Arrivals -->
        <div>
          <div class="eyebrow text-ink-mutedLt mb-4">{c.arrivalsLabel}</div>
          <div class="grid grid-cols-4 gap-3 mb-3">
            {c.arrivals.map((row) => (
              <div>
                <div class="text-[11px] tracking-[0.15em] uppercase text-ink-mutedLt">{row.year}</div>
                <div class="serif text-lg md:text-xl tabular text-ink mt-1">{row.value}</div>
              </div>
            ))}
          </div>
          <div class="flex items-baseline gap-3 pt-3 border-t border-line-dim/60">
            <span class="serif text-3xl md:text-4xl text-gold tabular">{c.arrivalsDelta}</span>
            <span class="eyebrow text-ink-mutedLt">{c.arrivalsDeltaLabel}</span>
          </div>
        </div>

        <!-- GDP -->
        <div class="pt-4 border-t border-line-dim/60">
          <div class="eyebrow text-ink-mutedLt mb-4">{c.gdpLabel}</div>
          <div class="grid grid-cols-4 gap-3 mb-3">
            {c.gdp.map((row) => (
              <div>
                <div class="text-[11px] tracking-[0.15em] uppercase text-ink-mutedLt">{row.year}</div>
                <div class="serif text-lg md:text-xl tabular text-ink mt-1">{row.value}</div>
              </div>
            ))}
          </div>
          <div class="flex items-baseline gap-3 pt-3 border-t border-line-dim/60">
            <span class="serif text-3xl md:text-4xl text-gold tabular">{c.gdpDelta}</span>
            <span class="eyebrow text-ink-mutedLt">{c.gdpDeltaLabel}</span>
          </div>
        </div>

        <div class="text-[11px] text-ink-mutedLt italic pt-2">{c.source}</div>
      </div>
    </div>
  </div>
</Section>
