---
import { getDict, type Locale } from '@/i18n';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = getDict(locale).transaction;
---

<section id="transaction" class="bg-white py-12 md:py-16">
  <div class="container-content">
    <div class="max-w-3xl mx-auto flex flex-col gap-10">
      <div class="reveal flex flex-col gap-3 items-start">
        <div class="inline-flex items-center bg-bg-dark text-[#ededed] px-3 py-1.5 rounded-3xl text-[11px] font-bold uppercase tracking-[2px]">
          {t.eyebrow}
        </div>
        <h2 class="serif text-[#222] text-2xl sm:text-3xl md:text-4xl leading-[1.1] tracking-[-0.01em]">
          {t.title}
        </h2>
      </div>

      <div class="grid lg:grid-cols-2 gap-6 lg:gap-8 items-stretch">
        <!-- LEFT: dark price card -->
        <div class="reveal bg-bg-dark rounded-3xl p-6 md:p-8 flex flex-col gap-4">
          <div class="text-[11px] font-bold uppercase tracking-[2px] text-white">{t.priceLabel}</div>
          <div class="serif text-5xl md:text-6xl lg:text-7xl text-white leading-none pb-4 tabular" data-count-up>{t.price}</div>
          <div class="grid grid-cols-2 gap-3">
            {t.metrics.map((m) => (
              <div class="border border-white/70 rounded-2xl px-4 py-3 md:px-5 md:py-4 flex flex-col gap-2">
                <div class="serif text-2xl md:text-[26px] text-white leading-tight tabular">{m.value}</div>
                <div class="text-[10px] md:text-[11px] font-bold uppercase tracking-[1.4px] leading-[14px] text-white/70">
                  {m.label}
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- RIGHT: included list -->
        <div class="reveal flex flex-col gap-5 justify-between">
          <div class="text-[11px] font-bold uppercase tracking-[2px] text-[#222]">{t.includedLabel}</div>
          <ul class="flex flex-col flex-1">
            {t.included.map((it, i) => (
              <li class={`flex gap-3 md:gap-4 items-baseline py-3 ${i < t.included.length - 1 ? 'border-b border-[#C9B98C]/40' : ''}`}>
                <span class="text-[#E6A25B] text-base leading-none shrink-0 mt-1">◆</span>
                <span class="text-[14px] md:text-[15px] font-bold text-[#222] leading-5 w-[96px] shrink-0">{it.label}</span>
                <span class="text-[13px] md:text-[14px] text-[#525252] leading-5 flex-1">{it.value}</span>
              </li>
            ))}
          </ul>
          <div class="bg-[#D5DEE3] rounded-2xl p-4 md:p-5">
            <p class="text-[13px] md:text-[14px] text-[#1F2937] leading-[1.5]">{t.note}</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
