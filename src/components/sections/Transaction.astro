---
import Eyebrow from '@/components/ui/Eyebrow.astro';
import Section from '@/components/ui/Section.astro';
import { getDict, type Locale } from '@/i18n';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = getDict(locale).transaction;
---

<Section id="transaction" variant="light">
  <div class="reveal">
    <Eyebrow text={t.eyebrow} />
    <h2 class="h1-section mt-4 max-w-3xl">{t.title}</h2>
  </div>

  <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 mt-12 md:mt-16 items-start">
    <!-- Price card (dark) -->
    <div class="reveal bg-bg-dark text-ink-white p-8 md:p-12">
      <div class="eyebrow text-gold-soft mb-4">{t.priceLabel}</div>
      <div class="serif text-6xl md:text-8xl text-gold tabular leading-none" data-count-up>{t.price}</div>
      <div class="mt-8 md:mt-12 grid grid-cols-2 gap-px bg-line-dark/40">
        {t.metrics.map((m, i) => (
          <div class="bg-card-dark p-5 md:p-6">
            <div
              class="serif text-2xl md:text-3xl text-ink-white tabular"
              data-count-up
              data-count-up-delay={String(i * 120)}
            >
              {m.value}
            </div>
            <div class="eyebrow text-ink-mutedDk mt-2">{m.label}</div>
          </div>
        ))}
      </div>
    </div>

    <!-- Included list -->
    <div class="reveal flex flex-col gap-6">
      <div class="eyebrow text-gold-deep">{t.includedLabel}</div>
      <ul class="border-t border-line-dim/60">
        {t.included.map((it) => (
          <li class="grid grid-cols-[auto_1fr_2fr] gap-4 md:gap-6 items-baseline py-3.5 border-b border-line-dim/40">
            <span class="text-gold serif text-xl">✓</span>
            <span class="text-sm md:text-[15px] font-semibold text-ink">{it.label}</span>
            <span class="text-sm md:text-[15px] text-ink-mutedLt">{it.value}</span>
          </li>
        ))}
      </ul>
      <div class="bg-tan-card/60 border border-line-dim p-5 md:p-6 mt-4">
        <p class="text-sm md:text-[15px] text-ink leading-relaxed">{t.note}</p>
      </div>
    </div>
  </div>
</Section>
