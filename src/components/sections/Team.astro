---
import Eyebrow from '@/components/ui/Eyebrow.astro';
import Section from '@/components/ui/Section.astro';
import { getDict, type Locale } from '@/i18n';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = getDict(locale).team;
---

<Section id="team" variant="dark">
  <div class="reveal">
    <Eyebrow text={t.eyebrow} variant="dark" />
    <h2 class="h1-section text-ink-white mt-4 max-w-3xl">{t.title}</h2>
  </div>

  <div class="grid lg:grid-cols-2 gap-px bg-line-dark/40 mt-12 md:mt-16 border border-line-dark/40">
    <!-- Track record -->
    <div class="bg-card-dark p-7 md:p-10 reveal flex flex-col gap-6">
      <div class="eyebrow text-gold-soft">{t.trackRecordLabel}</div>
      <ul class="flex flex-col divide-y divide-line-dark">
        {t.trackRecord.map((row, i) => (
          <li class="grid grid-cols-[auto_1fr] gap-5 md:gap-7 items-baseline py-4">
            <span
              class="serif text-2xl md:text-3xl text-gold tabular leading-none whitespace-nowrap min-w-[90px]"
              data-count-up
              data-count-up-delay={String(i * 120)}
            >
              {row.metric}
            </span>
            <span class="text-sm md:text-[15px] text-ink-mutedDk leading-relaxed">{row.label}</span>
          </li>
        ))}
      </ul>
    </div>

    <!-- Fee structure -->
    <div class="bg-card-dark p-7 md:p-10 reveal flex flex-col gap-6">
      <div class="eyebrow text-gold-soft">{t.feeStructureLabel}</div>
      <div class="flex items-baseline gap-4">
        <span class="serif text-7xl md:text-8xl text-gold tabular leading-none" data-count-up>{t.feeValue}</span>
        <span class="text-sm md:text-base text-ink-mutedDk">{t.feeUnit}</span>
      </div>
      <ul class="flex flex-col gap-3">
        {t.feeBullets.map((b) => (
          <li class="grid grid-cols-[auto_1fr] gap-3 items-start text-sm md:text-[15px] text-ink-mutedDk">
            <span class="text-gold serif text-lg leading-tight">✓</span>
            <span class="leading-relaxed">{b}</span>
          </li>
        ))}
      </ul>
      <div class="mt-2 inline-flex self-start px-4 py-2 bg-gold text-bg-dark text-xs md:text-sm font-semibold tracking-wider">
        {t.feePill}
      </div>
    </div>
  </div>

  <!-- Benchmark strip -->
  <div class="mt-12 reveal">
    <div class="eyebrow text-gold-soft mb-4">{t.benchmarkLabel}</div>
    <div class="grid md:grid-cols-2 gap-px bg-line-dark/40 border border-line-dark/40">
      <div class="bg-card-dark p-6 md:p-7 flex items-center">
        <div class="text-sm md:text-[15px] text-ink-mutedDk leading-relaxed">{t.benchmarkMarket}</div>
      </div>
      <div class="bg-card-dark p-6 md:p-7 border-l-2 border-gold flex items-center">
        <div class="text-sm md:text-[15px] text-ink-white leading-relaxed">{t.benchmarkOffer}</div>
      </div>
    </div>
  </div>
</Section>
