---
interface Props {
  text: string;
  variant?: 'light' | 'dark';
}
const { text, variant = 'light' } = Astro.props;
---

{variant === 'light' ? (
  <div class="inline-flex items-center bg-bg-dark text-white px-4 py-2 rounded-full text-[11px] md:text-xs font-bold uppercase tracking-[0.2em]">
    {text}
  </div>
) : (
  <div class="eyebrow text-gold-soft">{text}</div>
)}
