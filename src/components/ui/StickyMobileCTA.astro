---
import { getDict, type Locale } from '@/i18n';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = getDict(locale);
---

<div
  id="sticky-cta"
  class="fixed bottom-0 left-0 right-0 z-30 lg:hidden bg-bg-dark/95 backdrop-blur-md border-t border-line-dark/50 px-4 py-3 translate-y-full transition-transform duration-300"
>
  <a href="#nda" class="btn-primary w-full !py-3">{t.nav.requestNda}</a>
</div>

<script>
  const bar = document.getElementById('sticky-cta');
  if (bar) {
    const reveal = () => {
      const past = window.scrollY > window.innerHeight * 0.6;
      bar.style.transform = past ? 'translateY(0)' : 'translateY(100%)';
    };
    window.addEventListener('scroll', reveal, { passive: true });
    reveal();
  }
</script>
