---
import { getDict, type Locale } from '@/i18n';
import { Menu } from 'lucide-react';

interface Props {
  locale: Locale;
  altHref: string;
}

const { locale, altHref } = Astro.props;
const t = getDict(locale);

const links = [
  { href: '#highlights', label: t.nav.highlights },
  { href: '#gallery', label: t.nav.gallery },
  { href: '#financials', label: t.nav.financials },
  { href: '#transaction', label: t.nav.transaction },
  { href: '#process', label: t.nav.process },
];
---

<header
  data-nav
  class="fixed top-0 left-0 right-0 z-40 transition-colors duration-300"
>
  <div class="w-full px-6 md:px-10 lg:px-14 grid grid-cols-[1fr_auto_1fr] items-center h-16 md:h-20 pt-2 md:pt-4 gap-4">
    <!-- Left: nav links -->
    <nav class="hidden lg:flex items-center gap-2 justify-self-start">
      {links.map((l) => (
        <a
          href={l.href}
          class="bg-bg-dark/30 hover:bg-bg-dark/55 backdrop-blur-sm rounded-full px-3 py-1.5 text-[10px] uppercase tracking-[0.15em] text-ink-white transition-colors"
        >
          {l.label}
        </a>
      ))}
    </nav>

    <!-- Center: brand -->
    <a
      href="#top"
      class="flex items-baseline gap-2 text-ink-white hover:text-gold-soft transition-colors justify-self-start lg:justify-self-center"
    >
      <span class="serif text-xl md:text-2xl leading-none">Jazz Hotel</span>
      <span class="hidden sm:inline text-sm md:text-base tracking-wider leading-none">· 4★</span>
    </a>

    <!-- Right: lang switcher + CTA -->
    <div class="flex items-center gap-3 md:gap-5 justify-self-end">
      <div class="flex items-center text-[11px] md:text-xs tracking-[0.15em] uppercase text-ink-white">
        <span class={`px-1 ${locale === 'ru' ? '' : 'opacity-50'}`}>
          {locale === 'ru' ? 'RU' : <a href="/" class="hover:opacity-100">RU</a>}
        </span>
        <span class="opacity-40">/</span>
        <span class={`px-1 ${locale === 'en' ? '' : 'opacity-50'}`}>
          {locale === 'en' ? 'EN' : <a href={altHref} class="hover:opacity-100">EN</a>}
        </span>
      </div>

      <a
        href="#nda"
        class="hidden md:inline-flex bg-white text-ink rounded-full px-4 py-2 text-[11px] xl:text-xs font-medium tracking-[0.1em] uppercase hover:bg-gold-soft hover:text-ink transition-colors"
      >
        {t.nav.requestNda}
      </a>

      <button
        type="button"
        data-burger
        aria-expanded="false"
        aria-label="Menu"
        class="lg:hidden p-2 text-ink-white"
      >
        <Menu size={22} strokeWidth={1.5} />
      </button>
    </div>
  </div>

  <!-- Mobile menu drawer -->
  <div
    data-mobile-menu
    class="hidden flex-col bg-bg-dark border-t border-line-dark/50 lg:hidden"
  >
    <div class="container-content py-6 flex flex-col gap-5">
      {links.map((l) => (
        <a
          href={l.href}
          class="text-base uppercase tracking-[0.1em] text-ink-white hover:text-gold-soft transition-colors"
        >
          {l.label}
        </a>
      ))}
      <a
        href="#nda"
        class="bg-white text-ink rounded-full px-5 py-3 text-sm font-medium tracking-[0.1em] uppercase text-center"
      >
        {t.nav.requestNda}
      </a>
    </div>
  </div>
</header>

<script>
  const nav = document.querySelector<HTMLElement>('[data-nav]');
  if (nav) {
    const onScroll = () => {
      if (window.scrollY > 40) {
        nav.classList.add('bg-bg-dark/85', 'backdrop-blur-md', 'border-b', 'border-line-dark/40');
      } else {
        nav.classList.remove('bg-bg-dark/85', 'backdrop-blur-md', 'border-b', 'border-line-dark/40');
      }
    };
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }
</script>
